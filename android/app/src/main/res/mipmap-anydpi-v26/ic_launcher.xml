<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon on Android 8 and up, where the launcher masks it into
     whatever shape the phone uses: the mark on its own layer, the app's own
     background behind it. Older phones get mipmap/ic_launcher.png instead. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
